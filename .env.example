# Copy to .env and fill in real values before running the live test suite.
# .env is already gitignored.

# Base URL of the CxReports instance (no trailing slash), e.g. https://master.cx-reports.app
CX_REPORTS_URL=

# Default workspace ID or code used by tests that don't pass one explicitly
CX_REPORTS_WORKSPACE_ID=

# Personal Access Token used as the Bearer credential
CX_REPORTS_PAT=
