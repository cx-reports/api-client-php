# Copy to .env and fill in real values before running the live test suite.
# .env is already gitignored.

# Base URL of the CxReports instance (no trailing slash), e.g. https://master.cx-reports.app
CX_REPORTS_URL=

# Default workspace ID or code used by tests that don't pass one explicitly
CX_REPORTS_WORKSPACE_ID=

# Personal Access Token used as the Bearer credential
CX_REPORTS_PAT=

# --- Optional: smoke-test fixtures ---
# Tests that hit a specific report/workspace will skip themselves if these are unset.

# Report id (or type code) used by testDownloadPdf and testGetReportPreviewURL
CX_REPORTS_TEST_REPORT_ID=

# Report id and workspace id used by testDownloadPdfFromAnotherWs
CX_REPORTS_TEST_ALT_REPORT_ID=
CX_REPORTS_TEST_ALT_WORKSPACE_ID=

# Job id (or code) used by testStartNewJobRunAndStatus and the review/deliver tests
CX_REPORTS_TEST_JOB_ID=

# Existing job run id used by testGenerateJobRunReviewDocument and testDeliverAllJobRunEntries.
# WARNING: testDeliverAllJobRunEntries will actually deliver — only point this at a test/staging tenant.
CX_REPORTS_TEST_JOB_RUN_ID=
